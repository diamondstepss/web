# Diamond Stepss — Next.js app
# Project: cqqyikhvbvwvpbqmwxvl

NEXT_PUBLIC_SUPABASE_URL=https://your-ref.supabase.co

# PASTE YOUR PUBLISHABLE KEY BELOW.
# Supabase dashboard → Project Settings → API Keys → "Publishable key"
# Starts with  sb_publishable_...  or  eyJhbGciOi...
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

NEXT_PUBLIC_SITE_URL=https://diamondstepss.com

# Server-only secrets (never prefixed NEXT_PUBLIC_) — needed later for §8/§9 of PLAN.md
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_ENV=sandbox
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP=Primary
SHIPROCKET_WEBHOOK_TOKEN=
# Mirrors CASHFREE_ENV for the browser SDK ('sandbox' or 'production')
NEXT_PUBLIC_CASHFREE_ENV=sandbox
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend (transactional email) ──────────────────────────────────────────
# 1. Get an API key at resend.com/api-keys
# 2. Verify your sending domain at resend.com/domains (add the DNS records)
# 3. Point Supabase at Resend's SMTP so sign-in OTPs stop hitting the
#    built-in rate limit — see RESEND_SETUP.md
RESEND_API_KEY=
RESEND_FROM="Diamond Stepss <orders@diamondstepss.com>"

# ── Demo account ──────────────────────────────────────────────────────────
# Shows a "Try the demo" button on /login that signs in instantly.
# Leave BLANK in production and the button disappears on its own.
# This is an ordinary customer account — RLS scopes it to its own rows only.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=
